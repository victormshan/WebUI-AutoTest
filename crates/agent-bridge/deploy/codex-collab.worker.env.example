AGENT_BRIDGE_URL=http://127.0.0.1:7879
BRIDGE_BIN=/home/administrator/.local/bin/agent-bridge
BRIDGE_CLIENT_BIN=/mnt/e/Tools/npm/node_modules/@openai/codex/node_modules/@openai/codex-win32-x64/vendor/x86_64-pc-windows-msvc/bin/codex.exe
