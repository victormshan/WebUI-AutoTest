# Copy to ~/.config/agent-bridge/opencode.worker.env and edit paths before enabling.
BRIDGE_CLIENT=opencode
AGENT_BRIDGE_URL=http://127.0.0.1:7879
BRIDGE_BIN=/home/administrator/.local/bin/agent-bridge
BRIDGE_CLIENT_BIN=/home/administrator/.local/bin/opencode
BRIDGE_WORKDIR=/home/administrator/projects/Chrome-MCP
